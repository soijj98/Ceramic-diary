{
  "expo": {
    "name": "Klayria",
    "slug": "Klayria",
    "scheme": "ceramicsdiary",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.saija.ceramicsdiary"
    },
    "android": {
      "package": "com.klayria.app",
      "versionCode": 1
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4EADA"
        }
      ],
      "expo-status-bar"
    ]
  }
}
